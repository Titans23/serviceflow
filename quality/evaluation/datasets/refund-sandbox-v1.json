  "createdAt": "2026-10-24",
  "requiresSandbox": true,
  "cases": [
    {
      "id": "refund-success-replay",
      "principal": "customer",
      "split": "development",
      "sourceGroups": [],
      "fixture": {
        "orderStatus": "PROCESSING",
        "paymentStatus": "PAID",
        "owner": "customer",
        "amount": "99.00",
        "synthetic": true
      },
      "steps": [
        {
          "type": "chat",
          "message": "请取消订单 {{orderNo}}。",
          "expect": {
            "intent": "ORDER_QUERY",
            "events": [
              "token",
              "action_required",
              "done"
            ]
          }
        },
        {
          "type": "confirm",
          "decision": "CONFIRM",
          "expect": {
            "events": [
              "token",
              "done"
            ],
            "json": {
              "events.done.resultCode": "CANCELLED"
            }
          }
        },
        {
          "type": "http",
          "path": "/orders/{{orderNo}}",
          "capture": {
            "refundId": "body.refund.publicId"
          },
          "expect": {
            "json": {
              "body.status": "CANCELLED",
              "body.refund.status": "PROCESSING",
              "body.refund.attemptNo": 1
            }
          }
        },
        {
          "type": "http",
          "method": "POST",
          "path": "/admin/refunds/{{refundId}}/sandbox-events",
          "principal": "admin",
          "body": {
            "eventId": "{{eventId}}",
            "attemptNo": 1,
            "outcome": "SUCCEEDED",
            "amount": 99,
            "reason": ""
          },
          "expect": {
            "status": 200,
            "json": {
              "body.disposition": "APPLIED",
              "body.replayed": false
            }
          }
        },
        {
          "type": "http",
          "path": "/orders/{{orderNo}}",
          "expect": {
            "json": {
              "body.refund.status": "SUCCEEDED",
              "body.payment.refundStatus": "REFUNDED",
              "body.refund.attemptNo": 1
            }
          }
        },
        {
          "type": "http",
          "method": "POST",
          "path": "/admin/refunds/{{refundId}}/sandbox-events",
          "principal": "admin",
          "body": {
            "eventId": "{{eventId}}",
            "attemptNo": 1,
            "outcome": "SUCCEEDED",
            "amount": 99,
            "reason": ""
          },
          "expect": {
            "json": {
              "body.replayed": true
            }
          }
        }
      ]
    },
