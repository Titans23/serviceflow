# Grader-only Java acceptance. These variables do not replace the chatbot model.
# Prefer: python -B training/cli.py java-acceptance --attempt-name java-acceptance-<new-name>
SERVICEFLOW_GRADER_ACCEPTANCE_URL=http://127.0.0.1:8000
SERVICEFLOW_GRADER_ACCEPTANCE_MODEL=serviceflow-grader-qwen3-8b
SERVICEFLOW_GRADER_ACCEPTANCE_KEY=<local-inference-key>
