<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.serviceflow.mapper.UserMapper">
  <select id="findByUsername" resultType="com.serviceflow.model.AuthModels$User">
    SELECT id, username, password_hash, role, customer_id, enabled FROM app_user WHERE username = #{username}
  </select>
</mapper>
